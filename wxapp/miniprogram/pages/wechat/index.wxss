.page {
  padding: 20rpx 24rpx 60rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2e5fa3;
  margin-bottom: 16rpx;
}

.md-input {
  width: 100%;
  height: 360rpx;
  box-sizing: border-box;
  border: 1rpx solid #d9e2f0;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  background: #fbfcfe;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  background: #eef4fd;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #2e5fa3;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #2e5fa3;
  border: 1rpx solid #2e5fa3;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: #2e5fa3;
  color: #fff;
}

.btn[disabled] {
  opacity: 0.5;
}

.tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

.preview {
  width: 100%;
  font-size: 28rpx;
}

.img {
  width: 100%;
  border-radius: 8rpx;
}

.wc-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
}
