.page {
  padding: 20rpx 24rpx 60rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2e5fa3;
  margin-bottom: 16rpx;
}

.md-input {
  width: 100%;
  height: 360rpx;
  box-sizing: border-box;
  border: 1rpx solid #d9e2f0;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  background: #fbfcfe;
}

.palette {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.dot {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dot-check {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  text-shadow: 0 0 4rpx rgba(0, 0, 0, 0.4);
}

.tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #2e5fa3;
  border: 1rpx solid #2e5fa3;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: #2e5fa3;
  color: #fff;
}

.info {
  font-size: 26rpx;
  color: #444;
  line-height: 1.8;
}

.warn {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #c0392b;
}
