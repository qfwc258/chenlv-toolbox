<view class="page">
  <view class="card">
    <view class="card-title">Markdown 公文</view>
    <textarea
      class="md-input"
      value="{{md}}"
      bindinput="onMdInput"
      maxlength="-1"
      placeholder="输入 Markdown，如：# 民事起诉状&#10;原告：张三…"
    />
    <view class="row">
      <text class="label">规范</text>
      <radio-group class="chips" bindchange="onSpecChange">
        <label class="chip" wx:for="{{specs}}" wx:key="name">
          <radio value="{{item.name}}" checked="{{item.name === specName}}" color="#2E5FA3" />
          <text>{{item.name}}</text>
        </label>
      </radio-group>
    </view>
    <view class="row">
      <text class="label">页码</text>
      <switch checked="{{pageNumber}}" bindchange="onPageNumberChange" color="#2E5FA3" />
    </view>
    <view class="actions">
      <button class="btn primary" bindtap="onConvert">转换预览</button>
      <button class="btn" bindtap="onExport">导出 docx</button>
      <button class="btn" bindtap="onShare">分享文件</button>
    </view>
  </view>

  <view class="card" wx:if="{{info.title}}">
    <view class="card-title">转换结果</view>
    <view class="info">标题：{{info.title}}</view>
    <view class="info">段落：{{info.paraCount}} ｜ 表格：{{info.tableCount}}</view>
  </view>

  <view class="card" wx:if="{{previewHtml}}">
    <view class="card-title">预览</view>
    <rich-text class="preview" nodes="{{previewHtml}}" />
  </view>
</view>
